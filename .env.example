# Copy this file to .env and fill the values for your own Discord application.
# Never commit your real token or owner UID.

# Required: Discord bot token from Developer Portal > Bot > Reset Token.
DISCORD_TOKEN=

# Required for owner-only commands (.globalban, .lockall, bridgefilter, ...).
# Enable Developer Mode in Discord, right-click your user, then Copy User ID.
BOT_OWNER_ID=

# Member/mod commands use NORMAL_PREFIX; owner-only commands use OWNER_PREFIX.
NORMAL_PREFIX=!
OWNER_PREFIX=.

# Optional: sync slash commands instantly to one test guild. Leave empty for global sync.
GUILD_ID=

USE_ANIMATED_EMOJI=true
FEATURES_GIF_URL=
